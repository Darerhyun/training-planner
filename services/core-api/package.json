{
  "name": "@training-planner/core-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace=@training-planner/shared && tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed-reference-data": "npm run build --workspace=@training-planner/shared && tsx src/scripts/seed-reference-data.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "npm run build --workspace=@training-planner/shared && tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@hono/node-server": "^1.14.0",
    "@training-planner/shared": "*",
    "dotenv": "^17.4.2",
    "hono": "^4.7.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

# =============================================================================
# Training Schedule Planner - Environment Variables
# Copy to .env and fill in real values. Never commit .env or credentials.
# =============================================================================

# Database --------------------------------------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/training_planner
# Neon runtime placeholder: use the pooled Singapore endpoint with TLS.
# DATABASE_URL=postgresql://user:password@your-neon-pooler.example.invalid/training_planner?sslmode=require
# Use Neon's direct (non-pooled) URL only for approved administrative tasks such
# as schema application, pg_dump, or restore verification.

# Firebase Admin ---------------------------------------------------------------
# Local development only: keep service-account JSON in the uncommitted .env.
# Cloud Run should use Application Default Credentials through its runtime
# service identity; do not commit or paste credentials into deployment commands.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase Web Auth ------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Auth ------------------------------------------------------------------------
# Comma-separated bootstrap admins. Replace before an authorized deployment.
# All other new users start as 'pending' until an admin approves them.
ADMIN_EMAILS=owner@example.com

# API -------------------------------------------------------------------------
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Uploads ---------------------------------------------------------------------
# Placeholder only. Create and inject the real bucket during authorized recovery.
GCS_UPLOAD_BUCKET=your-upload-bucket

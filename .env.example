# =============================================================================
# Training Schedule Planner - Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# Database --------------------------------------------------------------------
# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# Firebase Admin ---------------------------------------------------------------
# Optional on Cloud Run if the runtime service account has Firebase Admin access.
# For local development, paste the service account JSON on one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase Web Auth ------------------------------------------------------------
# Used by the future Vite SPA for email magic-link sign-in.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Auth ------------------------------------------------------------------------
# Comma-separated emails that auto-receive 'admin' role on first login.
# All other new users start as 'pending' until an admin approves them.
ADMIN_EMAILS=owen@example.com

# API -------------------------------------------------------------------------
# Port for the core-api server. Cloud Run sets this automatically.
PORT=8080

# Comma-separated allowed origins for cross-origin requests.
# In production, set to your Firebase Hosting URL.
ALLOWED_ORIGINS=http://localhost:5173

# Public base URL consumed by the future Vite SPA.
VITE_API_BASE_URL=http://localhost:8080

# Uploads ---------------------------------------------------------------------
# GCS bucket used for uploaded Master Schedule Excel files.
GCS_UPLOAD_BUCKET=training-planner-uploads
